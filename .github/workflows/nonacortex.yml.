name: NONACORTEX FlyBrain Asíncrono

on:
  workflow_dispatch:
    inputs:
      document_text:
        description: 'Texto del contrato/documento a revisar'
        required: true

jobs:
  # ─── LOS 3 SELECTORES EN PARALELO ───
  alfa:
    name: Selector Alfa (Riesgos)
    runs-on: ubuntu-latest
    outputs:
      risk_json: ${{ steps.alfa.outputs.result }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v4
        with: { python-version: '3.10' }
      - run: pip install requests
      - id: alfa
        env:
          FEATHERLESS_KEY: ${{ secrets.FEATHERLESS_KEY }}
        run: |
          RESULT=$(python scripts/alfa.py "${{ github.event.inputs.document_text }}")
          echo "result=$RESULT" >> $GITHUB_OUTPUT

  phi:
    name: Selector Phi (Cumplimiento)
    needs: alfa
    runs-on: ubuntu-latest
    outputs:
      compliance_json: ${{ steps.phi.outputs.result }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v4
        with: { python-version: '3.10' }
      - run: pip install requests
      - id: phi
        env:
          FEATHERLESS_KEY: ${{ secrets.FEATHERLESS_KEY }}
        run: |
          RESULT=$(python scripts/phi.py '${{ needs.alfa.outputs.risk_json }}')
          echo "result=$RESULT" >> $GITHUB_OUTPUT

  omega:
    name: Selector Omega (Síntesis)
    needs: alfa
    runs-on: ubuntu-latest
    outputs:
      synthesis_json: ${{ steps.omega.outputs.result }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v4
        with: { python-version: '3.10' }
      - run: pip install requests
      - id: omega
        env:
          FEATHERLESS_KEY: ${{ secrets.FEATHERLESS_KEY }}
        run: |
          RESULT=$(python scripts/omega.py '${{ needs.alfa.outputs.risk_json }}')
          echo "result=$RESULT" >> $GITHUB_OUTPUT

  # ─── EL ÁRBITRO FINAL ───
  arbiter:
    name: Árbitro NONACORTEX
    needs: [alfa, phi, omega]
    runs-on: ubuntu-latest
    steps:
      - name: Emitir Veredicto Final
        run: |
          echo "### NONACORTEX FLYBRAIN - VEREDICTO FINAL ###"
          echo "**Riesgo:** ${{ needs.alfa.outputs.risk_json }}"
          echo "**Cumplimiento:** ${{ needs.phi.outputs.compliance_json }}"
          echo "**Síntesis:** ${{ needs.omega.outputs.synthesis_json }}"
          echo "**Ecuación de Cierre:** Ω = α + φ + π³"